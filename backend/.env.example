# Copie ce fichier en .env (dans backend/) puis complète les valeurs marquées « à remplir ».
# Ne mets jamais le fichier .env dans git : il est ignoré par backend/.gitignore.

# ---------------------------------------------------------------------------
# LLM (API compatible OpenAI)
# ---------------------------------------------------------------------------
# Ollama en local (par défaut). Pour Groq : LLM_BASE_URL=https://api.groq.com/openai/v1, ta clé Groq et un
# modèle Groq qui gère le tool calling.
LLM_BASE_URL=http://localhost:11434/v1
# Ollama n'en vérifie pas la valeur, mais elle ne doit pas être vide. Pour Groq ou OpenAI : ta clé (à remplir).
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
# Secondes avant d'abandonner un appel au LLM
LLM_TIMEOUT=120

# Fournisseur : openai (API compatible OpenAI, par défaut) ou hf-local (démonstration du modèle affiné,
# voir app/phase4_finetuning/README.md ; nécessite requirements-finetuning.txt et torch CUDA)
LLM_PROVIDER=openai
HF_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Dépôt du Hub (<utilisateur>/study-tutor-qwen2.5-1.5b-lora) ou dossier local de l'adaptateur LoRA
HF_ADAPTER=

# ---------------------------------------------------------------------------
# Hugging Face (optionnel)
# ---------------------------------------------------------------------------
# Jeton en lecture : utile seulement si le téléchargement du modèle d'embeddings est limité.
# Décommente la ligne et mets ton jeton si besoin.
# HF_TOKEN=
# Ton nom d'utilisateur Hugging Face (information pour le fine-tuning ; non lu par l'application)
# HF_USERNAME=

# ---------------------------------------------------------------------------
# Embeddings et base vectorielle
# ---------------------------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-small
QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Comptes étudiants (JWT)
# ---------------------------------------------------------------------------
# Obligatoire (à remplir) : une longue chaîne aléatoire, par exemple générée avec
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Chemins relatifs au dossier depuis lequel uvicorn est lancé (backend/)
DATABASE_URL=sqlite:///./study.db
STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Évaluation (MLflow)
# ---------------------------------------------------------------------------
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
