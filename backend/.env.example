# Copie ce fichier en .env (dans backend/) puis complète les valeurs marquées « à remplir ».
# Ne mets jamais le fichier .env dans git : il est ignoré par backend/.gitignore.

# ---------------------------------------------------------------------------
# LLM (API compatible OpenAI)
# ---------------------------------------------------------------------------
# Deux profils : garde-en un seul actif (les lignes LLM_BASE_URL / LLM_API_KEY / LLM_MODEL non commentées).
#
# --- Profil 1 : Ollama en local (développement, par défaut) ---
LLM_BASE_URL=http://localhost:11434/v1
# Ollama n'en vérifie pas la valeur, mais elle ne doit pas être vide.
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
#
# --- Profil 2 : Groq (API compatible OpenAI, offre gratuite avec limites de débit) ---
# Clé à créer sur https://console.groq.com/keys (à remplir). Quand LLM_BASE_URL pointe vers api.groq.com,
# GROQ_API_KEY est prioritaire sur LLM_API_KEY : docker-compose.yml passe ainsi sur Groq sans toucher à ce fichier.
# qwen/qwen3.8-27b : tool calling (agent) + sorties json_schema + bon en français (modèle « preview » chez Groq).
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=

# Secondes avant d'abandonner un appel au LLM
LLM_TIMEOUT=120
# Sorties JSON : json_schema (par défaut, repli automatique sur json_object si le modèle le refuse)
# ou json_object (forcé)
LLM_JSON_MODE=json_schema
# Erreurs 429 (limites de débit) : nouveaux essais, et attente maximale acceptée pour un essai (secondes)
LLM_RATE_LIMIT_RETRIES=4
LLM_RATE_LIMIT_MAX_WAIT=60

# Fournisseur : openai (API compatible OpenAI, par défaut) ou hf-local (démonstration du modèle affiné,
# voir app/phase4_finetuning/README.md ; nécessite requirements-finetuning.txt et torch CUDA)
LLM_PROVIDER=openai
HF_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Dépôt du Hub (<utilisateur>/study-tutor-qwen2.5-1.5b-lora) ou dossier local de l'adaptateur LoRA
HF_ADAPTER=
# Révisions du Hub (main par défaut) : mettre un hash de commit pour figer les poids téléchargés
HF_BASE_REVISION=main
HF_ADAPTER_REVISION=main

# ---------------------------------------------------------------------------
# Hugging Face (optionnel)
# ---------------------------------------------------------------------------
# Jeton en lecture : utile seulement si le téléchargement du modèle d'embeddings est limité.
# Décommente la ligne et mets ton jeton si besoin.
# HF_TOKEN=
# Ton nom d'utilisateur Hugging Face (information pour le fine-tuning ; non lu par l'application)
# HF_USERNAME=

# ---------------------------------------------------------------------------
# Embeddings et base vectorielle
# ---------------------------------------------------------------------------
EMBED_MODEL=intfloat/multilingual-e5-small
QDRANT_URL=http://localhost:6333
# Qdrant intégré, sans serveur (dossier local ou :memory:) : prioritaire sur QDRANT_URL s'il est rempli
QDRANT_PATH=

# ---------------------------------------------------------------------------
# Comptes étudiants (JWT)
# ---------------------------------------------------------------------------
# Obligatoire (à remplir) : une chaîne aléatoire de 32 caractères au moins (refusée sinon), générée avec
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24
# Connexion : après 5 échecs pour un même email en 15 min, réponse 429 jusqu'à la fin de la fenêtre
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Taille maximale d'un PDF importé (Mo), au-delà : 413 (même limite que le frontend et nginx)
MAX_UPLOAD_MB=50

# Origines autorisées à appeler l'API (séparées par des virgules) ; inutile derrière nginx (même origine)
CORS_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Stockage
# ---------------------------------------------------------------------------
# Chemins relatifs au dossier depuis lequel uvicorn est lancé (backend/)
DATABASE_URL=sqlite:///./study.db
STORAGE_DIR=./storage

# ---------------------------------------------------------------------------
# Évaluation (MLflow)
# ---------------------------------------------------------------------------
MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
